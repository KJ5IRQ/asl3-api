# Ensure Unix line endings on checkout for all files
# This is critical for install.sh and the service file to work correctly on Linux

* text=auto eol=lf

# Force these to LF regardless of platform
*.py    text eol=lf
*.sh    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.service text eol=lf
*.example text eol=lf

# Ignore binary files
*.png   binary
*.jpg   binary
*.gif   binary
