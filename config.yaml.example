# ASL3-API Configuration
# Copy this file to config.yaml and fill in your values.
# Never commit config.yaml to git — it contains secrets.

# ---------------------------------------------------------------------------
# Asterisk Manager Interface (AMI)
# These credentials must match the [asl3-api] section in manager.conf.
# ---------------------------------------------------------------------------
ami:
  host: "127.0.0.1"      # Always localhost — AMI must not be exposed externally
  port: 5038
  username: "asl3-api"   # AMI user defined in /etc/asterisk/manager.conf
  password: ""           # Generate with: openssl rand -base64 16

# ---------------------------------------------------------------------------
# Your AllStar node
# ---------------------------------------------------------------------------
node:
  number: ""             # Your node number, e.g. "637050"
  callsign: ""           # Your callsign, e.g. "KJ5IRQ"

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
api:
  host: "127.0.0.1"      # Remote use: VPN or authenticated TLS reverse proxy
  port: 8073
  api_key: ""            # Legacy single header key, used only when credentials is empty
  # Named credentials; control also permits observation. Generate distinct secrets.
  credentials: []
  # credentials:
  #   - name: dashboard
  #     key: "GENERATE-A-SECRET"
  #     authority: [observe]
  #   - name: operator
  #     key: "GENERATE-A-DIFFERENT-SECRET"
  #     authority: [observe, control]
  allow_legacy_query_key: false  # Only affects legacy /events; v1 is header-only

# Local durable state; all instances controlling this node MUST share lock_directory.
# Keep this directory private to the service account, on a local filesystem.
operations:
  state_directory: "/opt/asl3-api/state"
  lock_directory: "/opt/asl3-api/state"
  dispatch_timeout: 5
  effect_timeout: 8
  # Operations and Idempotency-Key bindings are retained indefinitely.

# ---------------------------------------------------------------------------
# SSE Event Stream
# GET /v1/events uses X-API-Key and periodic native RptStatus/XStat snapshots.
# No external rpt.conf event shell scripts are required. A snapshot may explicitly
# report STATE_UNKNOWN; missed transitions are not reconstructed or replayed.
# ---------------------------------------------------------------------------
events:
  enabled: true
  keepalive_interval: 15   # Seconds between SSE keepalive comments (prevents proxy timeout)
  snapshot_interval: 10    # Seconds between periodic full variable snapshots

# ---------------------------------------------------------------------------
# Webhooks (experimental — disabled by default)
# When enabled, ASL3-API POSTs JSON to the configured URL whenever a node
# connects or disconnects. Compatible with n8n, Zapier, or any HTTP endpoint.
# ---------------------------------------------------------------------------
webhooks:
  enabled: false
  url: ""                # e.g. "https://your-n8n.example.com/webhook/asl-events"

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
logging:
  level: "INFO"          # DEBUG, INFO, WARNING, ERROR
  audit_file: "/opt/asl3-api/audit.log"

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
security:
  rate_limit_per_minute: 60

# ---------------------------------------------------------------------------
# Timeouts
# Adjust if connecting to slow nodes (satellite links, intercontinental).
# ---------------------------------------------------------------------------
timeouts:
  connect_max_seconds: 12    # How long to wait for a connect to be confirmed
  disconnect_max_seconds: 8  # How long to wait for a disconnect to be confirmed
