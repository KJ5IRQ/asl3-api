# ASL3-API Configuration
# Copy this file to config.yaml and fill in your values.
# Never commit config.yaml to git — it contains secrets.

# ---------------------------------------------------------------------------
# Asterisk Manager Interface (AMI)
# These credentials must match the [asl3-api] section in manager.conf.
# ---------------------------------------------------------------------------
ami:
  host: "127.0.0.1"      # Always localhost — AMI must not be exposed externally
  port: 5038
  username: "asl3-api"   # AMI user defined in /etc/asterisk/manager.conf
  password: ""           # Generate with: openssl rand -base64 16

# ---------------------------------------------------------------------------
# Your AllStar node
# ---------------------------------------------------------------------------
node:
  number: ""             # Your node number, e.g. "637050"
  callsign: ""           # Your callsign, e.g. "KJ5IRQ"

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
api:
  host: "0.0.0.0"        # Listen on all interfaces; restrict with firewall
  port: 8073
  api_key: ""            # Generate with: openssl rand -base64 32

# ---------------------------------------------------------------------------
# SSE Event Stream
# When enabled, browsers and apps can connect to GET /events?api_key=KEY
# and receive live node state updates (RX keyed, TX keyed, link changes).
#
# IMPORTANT: For rxkeyed/txkeyed events to work, you must also configure
# the rpt.conf [events] stanza on your node. See INSTALLATION.md for
# the required shell scripts and rpt.conf additions. Without that step,
# only link connect/disconnect events and periodic snapshots are emitted.
# ---------------------------------------------------------------------------
events:
  enabled: true
  keepalive_interval: 15   # Seconds between SSE keepalive comments (prevents proxy timeout)
  snapshot_interval: 10    # Seconds between periodic full variable snapshots

# ---------------------------------------------------------------------------
# Webhooks (experimental — disabled by default)
# When enabled, ASL3-API POSTs JSON to the configured URL whenever a node
# connects or disconnects. Compatible with n8n, Zapier, or any HTTP endpoint.
# ---------------------------------------------------------------------------
webhooks:
  enabled: false
  url: ""                # e.g. "https://your-n8n.example.com/webhook/asl-events"

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
logging:
  level: "INFO"          # DEBUG, INFO, WARNING, ERROR
  audit_file: "/opt/asl3-api/audit.log"

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
security:
  rate_limit_per_minute: 60

# ---------------------------------------------------------------------------
# Timeouts
# Adjust if connecting to slow nodes (satellite links, intercontinental).
# ---------------------------------------------------------------------------
timeouts:
  connect_max_seconds: 12    # How long to wait for a connect to be confirmed
  disconnect_max_seconds: 8  # How long to wait for a disconnect to be confirmed
